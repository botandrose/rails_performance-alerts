<!DOCTYPE html>
<html>
<head>
  <meta content='text/html; charset=UTF-8' http-equiv='Content-Type' />
  <style>
    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
      line-height: 1.6;
      color: #333;
      max-width: 600px;
      margin: 0 auto;
      padding: 20px;
    }
    .alert-box {
      border-radius: 8px;
      padding: 20px;
      margin: 20px 0;
    }
    .alert-box.warning {
      background-color: #fff3cd;
      border: 2px solid #ffc107;
    }
    .alert-box.success {
      background-color: #d4edda;
      border: 2px solid #28a745;
    }
    .alert-header {
      font-size: 24px;
      font-weight: bold;
      margin-bottom: 15px;
    }
    .alert-box.warning .alert-header {
      color: #856404;
    }
    .alert-box.success .alert-header {
      color: #155724;
    }
    .alert-details {
      background-color: white;
      border-radius: 4px;
      padding: 15px;
      margin: 15px 0;
    }
    .detail-row {
      display: flex;
      padding: 8px 0;
      border-bottom: 1px solid #f0f0f0;
    }
    .detail-row:last-child {
      border-bottom: none;
    }
    .detail-label {
      font-weight: bold;
      min-width: 150px;
      color: #666;
    }
    .detail-value {
      color: #333;
    }
    .footer {
      margin-top: 30px;
      padding-top: 20px;
      border-top: 1px solid #ddd;
      font-size: 12px;
      color: #999;
    }
  </style>
</head>
<body>
  <%= yield %>

  <div class="footer">
    This is an automated alert from <%= @app_name %>
  </div>
</body>
</html>
